# 初次创建演示管理员时配置；只用于新账号，不会覆盖已有密码。
# 本机演示可按运行说明配置；部署环境由部署者设置。
DEMO_ADMIN_PASSWORD=
# 录制视频期间的本机快捷入口；关闭后仅保留注册与密码登录。公网始终不可用。
RECORDING_SHORTCUT_LOGIN=false
# 地图 JS API：保持 Web端(JS API) Key 与其对应的安全密钥。
AMAP_WEB_KEY=
AMAP_SECURITY_JS_CODE=
# 门店联想/详情：独立的 Web服务 Key，仅服务端使用；不得用它覆盖上面的 JS API Key。
# 高德控制台配置服务器出口 IP 白名单；当前部署 IP 为 your-server.example.com。
AMAP_REST_KEY=

# 邮箱验证码：仅服务端使用，配置 TLS SMTP 465；密码不要提交或打包。
MAIL_HOST=smtpdm.aliyun.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
